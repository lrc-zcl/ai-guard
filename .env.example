# 复制为 .env 后修改：  cp .env.example .env
# .env 含密钥，已在 .gitignore 中，不要提交。

# 网页登录账号 admin 的密码（用户名固定为 admin）。
# 设置后每次启动都以它为准，修改后重启即可重置密码；留空则首次启动随机生成并打印到日志。
AIG_ADMIN_PASSWORD=change-me-to-a-strong-password

# Agent 连接 Server 的内部凭据，Server 与所有 Agent 必须一致。
# 生成一个随机值，例如：  openssl rand -hex 24
AIG_AGENT_TOKEN=change-me-to-a-random-string

# PostgreSQL（可选）。默认账号/密码/库名见 docker-compose.yml：aig / aig_password / aig。
# 生产环境建议取消注释并改密码；注意密码只在 postgres 数据卷首次初始化时生效。
# POSTGRES_USER=aig
# POSTGRES_PASSWORD=aig_password
# POSTGRES_DB=aig

# API Checker（可选，默认值见 docker-compose.yml）
# AIG_API_CHECKER_MAX_JOBS=20
# AIG_API_CHECKER_ALLOW_HTTP=0
# AIG_API_CHECKER_ALLOW_PRIVATE_TARGETS=0
# AIG_API_CHECKER_CORS_ORIGINS=
